#! /usr/bin/env bash

source settings/main.sh
source lib/utilities.sh
source lib/cli.sh

while true; do
  if [[ $# == 0 ]]; then
    printf "\nUsage: run OPTION\n"
    printf "\nScript Options:\n"
    printf "  s: Setup\n"
    printf "  e: Edit configuration\n"
    printf "  o: Open configuration\n"
    printf "  E: Eject Card\n"
    printf "  q: Quit/Exit\n\n"
    read -r -p "Enter selection: " response
    printf "\n"
    process_option "$response"
  else
    process_option "$1"
  fi

  break
done
