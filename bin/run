#! /usr/bin/env bash

set -o nounset
set -o errexit
set -o pipefail
IFS=$'\n\t'

source ./lib/configuration.sh
source ./lib/kit.sh
source ./lib/orange.sh
source ./lib/raspberry.sh
source ./lib/cli.sh

while true; do
  if [[ $# == 0 ]]; then
    printf "\nUsage: run OPTION\n"
    printf "\nScript Options:\n"
    printf "  s:  Setup drive\n"
    printf "  op: Create Orange profile configuration\n"
    printf "  rp: Create Raspberry profile configuration\n"
    printf "  rn: Create Raspberry network configuration\n"
    printf "  c:  Create configuration\n"
    printf "  e:  Edit configuration\n"
    printf "  l:  List configurations\n"
    printf "  o:  Open configurations\n"
    printf "  d:  Delete configuration\n"
    printf "  E:  Eject drive\n"
    printf "  q:  Quit/Exit\n\n"
    read -r -p "Enter selection: " response
    printf "\n"
    process_option "$response"
  else
    process_option "$1"
  fi

  break
done
